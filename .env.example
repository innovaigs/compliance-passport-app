# Copy to .env and fill in. .env is gitignored — never commit real keys.
# The application reads these from the process environment and raises on absence;
# there are no fallback key literals anywhere in this repo.

# Anthropic API key. Powers the answer engine and the parser/writer code generation.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Daytona API key. Provisions the disposable sandbox each run executes inside.
# Get one at https://app.daytona.io
DAYTONA_API_KEY=

# Set to 1 ONLY to let the app start without Daytona. Runs are then marked degraded,
# execute nothing, and cannot export a file. Leave empty for normal operation.
COMPLIANCE_ALLOW_MOCK_SANDBOX=

# Optional. Defaults to claude-sonnet-4-5-20250929 when unset.
ANTHROPIC_MODEL=
